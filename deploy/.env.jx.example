# =============================================================================
# Sub2API "匠心版" Side-by-Side Deployment Environment
# =============================================================================
# Copy this file to .env.jx and adjust as needed:
#   cp .env.jx.example .env.jx
#
# Start with:
#   docker compose --env-file .env.jx -f docker-compose.jx.yml up -d --build
# =============================================================================

# Bind only to localhost by default.
# Put a reverse proxy (Caddy/Nginx) in front if you need public access.
BIND_HOST=127.0.0.1

# Host port for the "匠心版" app.
# Keep it different from the old/legacy Sub2API instance.
SERVER_PORT=18081

SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

# Request body limits. 600MiB leaves multipart overhead above the 512MiB plugin package limit.
SERVER_MAX_REQUEST_BODY_SIZE=629145600
GATEWAY_MAX_BODY_SIZE=629145600

# -----------------------------------------------------------------------------
# Isolated directory layout for the side-by-side deployment
# -----------------------------------------------------------------------------
APP_DATA_DIR=./jx-data
POSTGRES_DATA_DIR=./jx-postgres_data
REDIS_DATA_DIR=./jx-redis_data

# -----------------------------------------------------------------------------
# Optional naming overrides
# -----------------------------------------------------------------------------
JX_IMAGE_NAME=sub2api-jx:local
JX_APP_CONTAINER_NAME=sub2api-jx
JX_PG_CONTAINER_NAME=sub2api-jx-postgres
JX_REDIS_CONTAINER_NAME=sub2api-jx-redis
JX_NETWORK_NAME=sub2api-jx-network

# -----------------------------------------------------------------------------
# Database / Redis credentials for the new isolated stack
# -----------------------------------------------------------------------------
POSTGRES_USER=sub2api_jx
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=sub2api_jx

REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Auto-created admin account for the new stack
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin-jx@sub2api.local
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# IMPORTANT: use fixed secrets in production
# -----------------------------------------------------------------------------
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
JWT_EXPIRE_HOUR=24

# -----------------------------------------------------------------------------
# Optional Gemini / Antigravity OAuth secrets
# -----------------------------------------------------------------------------
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_SCOPES=
GEMINI_QUOTA_POLICY=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Optional security / networking
# -----------------------------------------------------------------------------
SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=
UPDATE_PROXY_URL=

# -----------------------------------------------------------------------------
# Optional connection pool overrides
# -----------------------------------------------------------------------------
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=10
REDIS_ENABLE_TLS=false
